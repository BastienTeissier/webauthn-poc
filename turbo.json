{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": ["^build"]
    },
    "test:circular": {
      "outputs": [],
      "inputs": [
        "**/*.tsx",
        "**/*.ts",
        "**/*.js",
        "**/package.json",
        "../../packages/dependency-cruiser-config-custom/**"
      ]
    },
    "lint": {
      "outputs": [],
      "inputs": [
        "**/*.tsx",
        "**/*.ts",
        "**/*.js",
        "**/package.json",
        "../../packages/eslint-config-custom/**"
      ],
      "dependsOn": ["^build"]
    },
    "lint:style": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "lint:fix": {
      "outputs": [],
      "dependsOn": ["^build"],
      "inputs": [
        "**/*.tsx",
        "**/*.ts",
        "**/*.js",
        "**/package.json",
        "../../packages/eslint-config-custom/**"
      ]
    },
    "lint:style:fix": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "test:type": {
      "outputs": [],
      "dependsOn": ["^build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    }
  }
}
